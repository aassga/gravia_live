# 第三個實盤進程（gravia-live3.service）專用覆寫；共用 .env 的私鑰／TG 設定。
POLY_LIVE_ASSET_ID=btc
POLY_LIVE_VARIANT_ID=btc-historical-hybrid
POLY_STRATEGY_ARMED=false
POLY_STAKE_PCT=30
POLY_SIM_ASSETS=btc
POLY_SIM_ONLY_VARIANTS=btc-historical-hybrid
POLY_SIM_PORT=8771
POLY_SIM_DB_PATH=/home/ubuntu/gravia_live/polymarket_sim_live3.sqlite3
POLY_LIVE_STATE_FILE=/home/ubuntu/gravia_live/polymarket_live3_state.json
POLY_LIVE_ENV_FILE=/home/ubuntu/gravia_live/.env.live3
POLY_LIVE_BASELINE_FILE=/home/ubuntu/gravia_live/polymarket_live3_baseline.json
POLY_LIVE_STATUS_PORT=8770
POLY_LIVE_SIZING_MODE=equity
POLY_LIVE_PEER_STATE_FILES=/home/ubuntu/gravia_live/polymarket_live_strategy_state.json,/home/ubuntu/gravia_live/polymarket_live2_state.json
