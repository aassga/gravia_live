[Unit]
Description=Gravia non-BTC crypto 5m paper simulations
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/gravia_live
Environment=PYTHONUNBUFFERED=1
Environment=POLY_SIM_PORT=8769
Environment=POLY_SIM_ASSETS=eth-alt,sol,xrp,bnb,doge,hype,zec
Environment=POLY_SIM_DB_PATH=/home/ubuntu/gravia_live/polymarket_altcoins.sqlite3
EnvironmentFile=/home/ubuntu/gravia_live/.env
ExecStart=/home/ubuntu/venv/bin/python /home/ubuntu/gravia_live/polymarket_server.py
Restart=on-failure
RestartSec=3
Nice=15
CPUQuota=40%
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
