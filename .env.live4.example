POLY_LIVE_SIZING_MODE=equity
POLY_LIVE_PEER_STATE_FILES=/home/ubuntu/gravia_live/polymarket_live_strategy_state.json,/home/ubuntu/gravia_live/polymarket_live2_state.json,/home/ubuntu/gravia_live/polymarket_live3_state.json,/home/ubuntu/gravia_live/polymarket_live5_state.json
