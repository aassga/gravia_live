# 第四個實盤進程（gravia-live4.service）：ETH 15m 最後 30～60 秒 0.98～0.99、不停損
POLY_LIVE_ASSET_ID=eth-15m
POLY_LIVE_VARIANT_ID=eth-15m-auto-30-60s-098-099
POLY_STRATEGY_ARMED=false
POLY_STAKE_PCT=10
POLY_SIM_ASSETS=eth-15m
POLY_SIM_ONLY_VARIANTS=eth-15m-auto-30-60s-098-099
