# 第二個實盤進程（gravia-live2.service）專用覆寫；共用 .env 的私鑰／TG 設定。
POLY_LIVE_ASSET_ID=btc
POLY_LIVE_VARIANT_ID=btc-historical-hybrid
POLY_STRATEGY_ARMED=false
POLY_STAKE_PCT=30
# 只跑自己的變體，不重複跑整個模擬盤
POLY_SIM_ASSETS=btc
POLY_SIM_ONLY_VARIANTS=btc-historical-hybrid
POLY_SIM_PORT=8769
POLY_SIM_DB_PATH=/home/ubuntu/gravia_live/polymarket_sim_live2.sqlite3
# 自己的狀態／env／基準檔與狀態埠
POLY_LIVE_STATE_FILE=/home/ubuntu/gravia_live/polymarket_live2_state.json
POLY_LIVE_ENV_FILE=/home/ubuntu/gravia_live/.env.live2
POLY_LIVE_BASELINE_FILE=/home/ubuntu/gravia_live/polymarket_live2_baseline.json
POLY_LIVE_STATUS_PORT=8768
# 算法 B：每注比例的基準 = 現金 + 所有實盤在場部位成本
POLY_LIVE_SIZING_MODE=equity
POLY_LIVE_PEER_STATE_FILES=/home/ubuntu/gravia_live/polymarket_live_strategy_state.json
