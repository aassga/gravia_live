# 複製這個檔案為 .env 並填入你自己的值。
# .env 已加入 .gitignore，不會被提交到 git，但仍請妥善保管，不要分享給任何人。
# 注意：這份 .env.example 本身「會」被提交到 git，絕對不要在這裡填真實金鑰！

# 你的 EOA 私鑰（0x 開頭），用來簽署訂單。
# 強烈建議使用「專門給機器人用的獨立錢包」，不要用主錢包的私鑰。
POLY_PRIVATE_KEY=0xyour_private_key_here

# 你的 Polymarket 帳號地址（deposit wallet / proxy wallet）。
# 在 polymarket.com 登入後，點「你的 Polymarket 錢包地址」可以找到這個地址。
POLY_FUNDER_ADDRESS=0xyour_polymarket_account_address_here

# CLOB API 主機，一般不需要更改
POLY_CLOB_HOST=https://clob.polymarket.com

# Polygon 主網 chain id，一般不需要更改
POLY_CHAIN_ID=137

# 簽名類型：0=EOA, 1=POLY_PROXY(舊版), 2=POLY_GNOSIS_SAFE, 3=POLY_1271(V2 新式 deposit wallet)
# 2026-04 後新建的帳號多半用 3，不確定就先試 3，查餘額查不到再換 1 / 2 試試看。
POLY_SIGNATURE_TYPE=3

# 每注佔真實資產組合的百分比（複利，跟模擬版邏輯一致），0.5~25 之間
POLY_STAKE_PCT=15

# Real two-leg safeguards. A pair must remain unchanged for the stability window,
# and each leg must show this multiple of the order size inside its submitted limit.
POLY_LIVE_VARIANT_ID=btc-historical-hybrid
POLY_LIVE_LOCK_MAX_SUM=0.95
POLY_PAIR_MIN_DEPTH_MULTIPLIER=1.3
POLY_PAIR_STABILITY_SECONDS=0.15
POLY_RESCUE_LOCK_MAX_SUM=0.99
# Single-leg fallback when no two-leg lock exists: buy the cheaper side when its
# limit price <= this cap and the fair-value edge >= SIM_MIN_ENTRY_EDGE.
# Defaults to the variant entryMaxPrice (None for btc-historical-hybrid); 0 disables.
POLY_LIVE_ENTRY_MAX_PRICE=0.45
# Stop-loss for single-leg entries only: sell via FOK when the held side's conservative
# sellable price <= entry fill price * (1 - pct/100). 0 disables. Late-direction holds to settlement.
POLY_LIVE_SINGLE_LEG_STOP_LOSS_PCT=40
# Single-leg entries are limited to one per window; additionally skip them when fewer
# than this many seconds remain in the window (late-window prices move too fast).
POLY_LIVE_SINGLE_LEG_MIN_REMAINING=90
# Late-favorite variant only: sell the held side via FOK when its conservative sellable
# price <= this (the leader flipped). Defaults to the variant value (0.60); 0 disables.
POLY_LIVE_FAVORITE_STOP_LOSS_PRICE=0.60
# Late-favorite: require Chainlink 60s TWAP to deviate from the window-open TWAP by at
# least this many percent (and in the leader's direction). No signal = no entry.
POLY_LIVE_FAVORITE_MIN_DELTA_PCT=0.005

# 安全開關：預設 false（只會模擬/預覽下單，不會真的送出）。
# 要真的送出真實訂單，必須手動改成 true —— 請務必先確認金額、部位大小都測試過。
LIVE_TRADING=false

# Second live-order interlock. Both this and LIVE_TRADING must be true before
# the strategy can submit any real order.
POLY_STRATEGY_ARMED=false

# Optional single-leg directional fallback near settlement. Disabled by default
# because it is directional risk, not a two-leg locked-profit trade.
POLY_ENABLE_LATE_DIRECTION=false

# Safe diagnostic mode: prewarm metadata and sign a two-leg FOK batch for each
# new market, but never call POST /orders. When true, this hard-disables real
# execution even if the two live-order switches above are accidentally true.
POLY_VALIDATE_ORDER_PATH=false
