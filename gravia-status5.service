[Unit]
Description=Gravia Polymarket read-only live status #5 (port 8774)
Wants=network-online.target
After=network-online.target gravia-live5.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/gravia_live
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ubuntu/gravia_live/.env
EnvironmentFile=/home/ubuntu/gravia_live/.env.live5
ExecStart=/home/ubuntu/venv/bin/python /home/ubuntu/gravia_live/polymarket_live_status_server.py
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
