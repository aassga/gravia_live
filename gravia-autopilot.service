[Unit]
Description=Gravia sim autopilot: scan all Polymarket up/down series, add best rules to the paper sim, disable big losers
Wants=network-online.target
After=network-online.target gravia.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/gravia_live
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ubuntu/gravia_live/.env
ExecStart=/home/ubuntu/venv/bin/python /home/ubuntu/gravia_live/polymarket_autopilot.py --hours 72
TimeoutStartSec=3600
