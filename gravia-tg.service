[Unit]
Description=Gravia Polymarket Telegram status bot (read-only except the /live REAL/DRY-RUN switch)
Wants=network-online.target
After=network-online.target gravia-status.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/gravia_live
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ubuntu/gravia_live/.env
ExecStart=/home/ubuntu/venv/bin/python /home/ubuntu/gravia_live/polymarket_tg_bot.py
Restart=on-failure
RestartSec=5
UMask=0077
# 2026-09-15：/live 開關要用 sudo -n systemctl restart，不能開 NoNewPrivileges
PrivateTmp=true

[Install]
WantedBy=multi-user.target
